# 이 파일을 .env.local 로 복사하고 값을 채워 넣으세요.

# TourAPI 서비스키 (공공데이터포털, 디코딩된 형태)
# 프록시에서만 쓰이며 프론트 번들에는 포함되지 않습니다.
# `npm run related:index`(추천 인덱스 다시 만들기)도 이 키로 "관광지별 연관 관광지 정보"를 부릅니다 —
# 팀 키는 이미 신청돼 있고, 개인 키라면 공공데이터포털에서 그 서비스도 활용신청하세요.
# 앱 실행에는 필요 없습니다(인덱스 파일이 커밋돼 있음).
TOUR_API_SERVICE_KEY=

# 카카오맵 JavaScript 키 (카카오 개발자 콘솔 → 앱 키)
# 프론트에 노출되는 값이며 도메인 등록으로 보호됩니다.
VITE_KAKAO_MAP_KEY=

# Firebase (google-services.json 또는 콘솔 → 프로젝트 설정에서 확인)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
